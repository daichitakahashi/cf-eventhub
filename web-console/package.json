{
  "name": "@cf-eventhub/web-console",
  "type": "module",
  "version": "0.0.17",
  "repository": {
    "url": "https://github.com/daichitakahashi/cf-eventhub"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "build": "tsup"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.5.3",
    "clsx": "^2.1.1",
    "hono": "^4.9.10",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "cf-eventhub": "^0.3.5",
    "tsup": "^8.3.5",
    "typed-htmx": "^0.3.1",
    "typescript": "^5.6.2",
    "wrangler": "catalog:"
  },
  "tsup": {
    "entry": ["src/index.ts"],
    "splitting": false,
    "sourcemap": true,
    "format": ["esm", "cjs"],
    "dts": true,
    "clean": true
  },
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "files": ["dist"]
}
