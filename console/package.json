{
  "name": "@cf-eventhub/console",
  "type": "module",
  "version": "0.0.0",
  "repository": {
    "url": "https://github.com/daichitakahashi/cf-eventhub"
  },
  "scripts": {
    "build:styles": "tailwindcss -i ./src/app/tailwind.css -o ./src/app/styles.css --minify && node ./scripts/embed-styles.mjs",
    "dev": "wrangler dev",
    "deploy": "pnpm build:styles && wrangler deploy --minify"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.5.3",
    "hono": "^4.9.10",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/cli": "^4.3.1",
    "eventhub": "workspace:*",
    "typescript": "^5.6.2",
    "wrangler": "catalog:"
  },
  "exports": {
    "types": "./src/index.ts",
    "default": "./src/index.ts"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "CHANGELOG.md"
  ]
}
