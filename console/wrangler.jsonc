{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "console",
  "main": "src/dev.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_HUB",
        "class_name": "MyEventHub",
        "script_name": "dev-eventhub"
      }
    ]
  }
}
