{
  "name": "cf-eventhub",
  "type": "module",
  "version": "0.3.5",
  "description": "An event aggregation and delivery component built on Cloudflare Durable Objects.",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "event-driven"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daichitakahashi/cf-eventhub.git",
    "directory": "cf-eventhub"
  },
  "homepage": "https://github.com/daichitakahashi/cf-eventhub#readme",
  "bugs": {
    "url": "https://github.com/daichitakahashi/cf-eventhub/issues"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "^25.6.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/core/mock.ts",
    "!src/test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
